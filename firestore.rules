rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Primary Super Admin
    function isPrimaryAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'fernandes.wesley@gmail.com'
      );
    }

    // Authorized Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'fernandes.wesley@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public Store Catalog & Settings Collections (Public Read, Admin Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /benefits/{benefitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /neighborhoods/{neighborhoodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Visitors can create orders; only authenticated admins can read, update, or delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admins List: only authorized admins can read; only primary admin can write
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isPrimaryAdmin();
    }
  }
}

