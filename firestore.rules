rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated with a non-anonymous account
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Authorized Admins: strictly limited to the two authorized administrative accounts
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'casaderacoespets@gmail.com' ||
        request.auth.token.email == 'fernandes.wesley@gmail.com'
      );
    }

    // Public Store Catalog & Settings Collections (Public Read, Admin Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /benefits/{benefitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /neighborhoods/{neighborhoodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Visitors can create orders; only authenticated admins can read, update, or delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admins Collection: restricted strictly to the two authorized administrators
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
