{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store pet product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "species": { "type": "string" },
        "brand": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "onSale": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "category", "species"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer checkout order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "customer": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "items", "total", "customer", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog products with admin management"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders submitted at checkout"
    }
  }
}
